# Firebase web app config (Firebase Console -> Project settings -> Your apps).
# Copy this file to .env.local and fill in the values; .env.local is not committed.
# scripts/write-environment.mjs turns them into src/environments/firebase.env.ts before every run.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
